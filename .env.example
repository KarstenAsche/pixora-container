# Django
DEBUG=True
SECRET_KEY=replace-with-a-generated-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Database
USE_SQLITE=True
SQLITE_PATH=/app/data/db.sqlite3

# Media
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
MAX_IMAGE_SIZE_MB=5

# Frontend
FRONTEND_PORT=4200
