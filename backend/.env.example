DEBUG=True
SECRET_KEY=your-very-secret-key-here

# Set to True for local development (no PostgreSQL needed)
USE_SQLITE=True

# PostgreSQL settings (only used when USE_SQLITE=False)
DB_NAME=pixora
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

MAX_IMAGE_SIZE_MB=5

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
MEDIA_ROOT=
MEDIA_URL=/media/
